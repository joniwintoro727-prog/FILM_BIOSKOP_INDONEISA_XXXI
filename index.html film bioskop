body {
margin: 0;
font-family: Arial, sans-serif;
background: #111;
color: white;
}

header {
padding: 20px;
display: flex;
justify-content: space-between;
align-items: center;
}

input {
padding: 10px;
width: 200px;
}

.film-list {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
gap: 15px;
padding: 20px;
}

.film-card img {
width: 100%;
border-radius: 10px;
}

.film-card a {
color: red;
text-decoration: none;
}
const search = document.getElementById("search");
const films = document.querySelectorAll(".film-card");

search.addEventListener("keyup", () => {
const value = search.value.toLowerCase();

films.forEach(film => {
const title = film.dataset.title.toLowerCase();
film.style.display = title.includes(value) ? "block" : "none";
});
});
